[% USE raw %]
[% INCLUDE 'doc-head-open.inc' %]
<title>Koha: ISO18626 Configuration</title>
[% INCLUDE 'doc-head-close.inc' %]
<style>
    input:not([type="submit"]):not([type="search"]):not([type="button"]):not(
            [type="checkbox"]
        ):not([type="radio"]){
        border-color: rgba(60, 60, 60, 0.26);
        border-width: 1px;
        border-radius: 4px;
        min-width: 30%;
    }
</style>
</head>
<body>
[% WRAPPER 'header.inc' %]
    [% INCLUDE 'cat-search.inc' %]
[% END %]

[% WRAPPER 'sub-header.inc' %]
    [% WRAPPER breadcrumbs %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/plugins-home.pl">Plugins</a>
        [% END %]
        [% WRAPPER breadcrumb_item %]
            <a href="/cgi-bin/koha/plugins/run.pl?class=Koha%3A%3APlugin%3A%3ACom%3A%3AOpenFifth%3A%3AISO18626&amp;method=configure">ISO18626</a>
        [% END %]
        [% WRAPPER breadcrumb_item bc_active = 1 %]
            <a href="#">Configuration</a>
        [% END %]
    [% END #/ WRAPPER breadcrumbs %]
[% END #/ WRAPPER sub-header.inc %]

<div class="main container-fluid">
    <div class="row">
        <div class="col-md-10 offset-md-2 order-sm-1">
            <h1>ISO18626 configuration</h1>
            [% IF core_supports_requesting %]
            <div class="alert alert-info">
                Supplying agencies are configured in Koha, under <a href="/cgi-bin/koha/ill/iso18626_supplying_agencies">Interlibrary loans &rsaquo; Supplying agencies</a>.
                Below are the settings this plugin uses to search their catalogues and retrieve their documents.
            </div>
            [% ELSE %]
            <div class="alert alert-warning">This Koha version cannot send ISO18626 requests. This plugin needs bug 41091.</div>
            [% END %]

            <form id="iso18626_configure" method="get">
                <input type="hidden" name="class"  value="[% CLASS %]"/>
                <input type="hidden" name="method" value="[% METHOD %]"/>
                <input type="hidden" name="save"   value="1"/>

                [% FOREACH supplying_agency IN supplying_agencies %]
                [% SET agency = supplying_agency.agency %]
                [% SET id = agency.iso18626_supplying_agency_id %]
                <fieldset class="rows">
                    <legend>[% agency.name || agency.agency_id | html %]</legend>
                    <ol>
                        <li>
                            <span class="label">ISO18626 endpoint URL:</span>
                            [% agency.endpoint | html %]
                        </li>
                        <li>
                            <label for="agency_api_user_[% id | html %]">API username:</label>
                            <input type="text" id="agency_api_user_[% id | html %]" name="agency_api_user_[% id | html %]" placeholder="Koha REST API username for search" value="[% supplying_agency.api_user | html %]">
                            <a href="#" data-bs-toggle="tooltip" title="Koha REST API username used to search the supplying agency's catalogue."><i class="fa-solid fa-circle-question"></i></a>
                        </li>
                        <li>
                            <label for="agency_api_password_[% id | html %]">API password:</label>
                            <input type="password" id="agency_api_password_[% id | html %]" name="agency_api_password_[% id | html %]" placeholder="Koha REST API password for search" value="[% supplying_agency.api_password | html %]">
                            <a href="#" data-bs-toggle="tooltip" title="Koha REST API password used to search the supplying agency's catalogue."><i class="fa-solid fa-circle-question"></i></a>
                        </li>
                        <li>
                            <label for="agency_document_host_[% id | html %]">Document host:</label>
                            <input type="text" id="agency_document_host_[% id | html %]" name="agency_document_host_[% id | html %]" placeholder="e.g. catalogue.supplier.example.com" value="[% supplying_agency.document_host | html %]">
                            <a href="#" data-bs-toggle="tooltip" title="Host the supplying agency sends document download links from, if different from the endpoint URL's host (usually its OPAC). Documents are only retrieved from these hosts."><i class="fa-solid fa-circle-question"></i></a>
                        </li>
                    </ol>
                </fieldset>
                [% END %]

                <fieldset class="action">
                    <input id="submit_button" class="btn btn-primary" type="submit" value="Save configuration"/>
                </fieldset>
            </form>
        </div>
    </div>
</div>

[% INCLUDE 'intranet-bottom.inc' %]
